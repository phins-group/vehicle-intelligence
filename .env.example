MONGODB_HOST_PORT=27017
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8000
WEB_HOST_PORT=4200
RTSP_HOST_PORT=8554

# The bundled values are for local acceptance and intentionally fail the static
# production-readiness gate. Production must use immutable config/model versions
# and secret-manager overrides rather than copying development credentials.
# VIP_APP__ENVIRONMENT=production
# VIP_APP__CONFIG_VERSION=site-a-2026-08-10
# VIP_VISION__VEHICLE_DETECTION__MODEL_PATH=models/vehicle-detector-v1.onnx
# VIP_VISION__VEHICLE_DETECTION__MODEL_VERSION=v1
# VIP_VISION__VEHICLE_DETECTION__MODEL_HASH=<sha256-hex>
# VIP_VISION__PLATE_DETECTION__MODEL_PATH=models/vietnam-plate-v1.onnx
# VIP_VISION__PLATE_DETECTION__MODEL_VERSION=v1
# VIP_VISION__PLATE_DETECTION__MODEL_HASH=<sha256-hex>

VIP_MONGODB__URI=mongodb://localhost:27017/?directConnection=true
VIP_MONGODB__DATABASE=vehicle_intelligence
VIP_MONGODB__TRANSACTIONS_ENABLED=true
# Bounds outage detection; tune above measured p99 but below worker retry SLO.
VIP_MONGODB__CONNECT_TIMEOUT_MS=3000
VIP_MONGODB__SOCKET_TIMEOUT_MS=10000
VIP_REDIS__URL=redis://localhost:6379/0
# Redis Pub/Sub is best-effort realtime fan-out; MongoDB remains the recovery
# source after disconnects or slow-client gaps.
VIP_REALTIME__ENABLED=true
# ONVIF discovery only returns credential-free local-network metadata. Camera
# admission and supervisor concurrency are bounded independently.
VIP_ONVIF_DISCOVERY__ENABLED=true
VIP_ONVIF_DISCOVERY__TIMEOUT_SECONDS=3.0
VIP_ONVIF_DISCOVERY__PROBE_RETRIES=2
VIP_ONVIF_DISCOVERY__MAXIMUM_RESULTS=128
VIP_CAMERA_MANAGER__MAXIMUM_CONFIGURED_CAMERAS=256
VIP_CAMERA_MANAGER__MAXIMUM_ACTIVE_WORKERS=32
VIP_CAMERA_MANAGER__MAXIMUM_STARTS_PER_RECONCILE=4
VIP_CAMERA_MANAGER__BATCH_CREATE_LIMIT=50
VIP_OBSERVABILITY__PROMETHEUS_ENABLED=true
VIP_OBSERVABILITY__RETENTION_METRICS_PORT=9101
VIP_OBSERVABILITY__OPENTELEMETRY_ENABLED=false
VIP_OBSERVABILITY__OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
VIP_OBSERVABILITY__TRACE_SAMPLE_RATIO=0.1
VIP_RETENTION__ENABLED=false
VIP_RETENTION__WORKER_INTERVAL_SECONDS=3600
VIP_RETENTION__BATCH_SIZE=100
VIP_RETENTION__VEHICLE_EVENTS_DAYS=365
VIP_RETENTION__SNAPSHOTS_DAYS=30
VIP_RETENTION__VEHICLE_CROPS_DAYS=30
VIP_RETENTION__PLATE_CROPS_DAYS=30
VIP_RETENTION__EVENT_CLIPS_DAYS=14
VIP_RETENTION__DEBUG_IMAGES_DAYS=7
VIP_RETENTION__MINIO_LIFECYCLE_ENABLED=true
# MinIO cleans abandoned multipart uploads at server level; canonical media
# retention remains coordinated by the retention worker so dataset pins win.
MINIO_API_STALE_UPLOADS_EXPIRY=24h
MINIO_API_STALE_UPLOADS_CLEANUP_INTERVAL=6h
# VIP_REALTIME__REDIS_CHANNEL=vehicle.events.realtime
# External HTTP/webhook/barrier actions stay disabled unless an explicit
# hostname allowlist is also configured.
VIP_RULE_ENGINE__EXTERNAL_ACTIONS_ENABLED=false
# Exact hostnames only; JSON syntax is required by the environment parser.
# VIP_RULE_ENGINE__EXTERNAL_ALLOWED_HOSTS='["barrier.internal","hooks.example.com"]'
# Prefer structured targets: HTTPS by default, optional managed Bearer/HMAC secret,
# bounded circuit breaker, and no rule-supplied credentials.
# VIP_RULE_ENGINE__EXTERNAL_TARGETS='[{"host":"hooks.example.com","authentication":"hmac_sha256","hmac_secret":"<secret>","hmac_key_id":"webhook-v1"}]'
# Authentication is deliberately disabled for local development. Production must
# set enabled=true and provide SHA-256 verifiers for high-entropy Bearer keys.
VIP_AUTH__ENABLED=false
VIP_AUTH__PROVIDER=api_key
# VIP_AUTH__PRINCIPALS='[{"id":"admin-01","display_name":"Platform Admin","role":"ADMIN","key_sha256":"<64-hex-sha256>","enabled":true}]'
# Central identity example (all algorithms are server-configured, never token-selected):
# VIP_AUTH__PROVIDER=oidc
# VIP_AUTH__OIDC='{"issuer":"https://identity.example.com","jwks_url":"https://identity.example.com/.well-known/jwks.json","audiences":["vehicle-intelligence"],"algorithms":["RS256"],"roles_claim":"roles","role_mapping":{"vip-admin":"ADMIN","vip-operator":"OPERATOR","vip-viewer":"VIEWER"}}'
# Generate a 32-byte URL-safe base64 key; never commit the real value.
# VIP_SECURITY__CAMERA_CREDENTIAL_KEY=
VIP_SECURITY__CAMERA_CREDENTIAL_KEY_ID=primary
# Rotation keyring example. Retain old keys until the controlled rotation command
# reports every document on the new active key.
# VIP_SECURITY__CAMERA_CREDENTIAL_KEYS='[{"id":"old","key":"<base64>"},{"id":"new","key":"<base64>"}]'
# VIP_SECURITY__CAMERA_CREDENTIAL_ACTIVE_KEY_ID=new
VIP_MINIO__ENDPOINT=localhost:9000
# Browser-reachable host[:port], without http:// or https://. The bundled Nginx
# proxies /vehicle-media on its own origin; production must provide the same
# signed bucket-path route on its externally reachable gateway hostname.
VIP_MINIO__PUBLIC_ENDPOINT=localhost:4200
VIP_MINIO__REGION=us-east-1
VIP_MINIO__ACCESS_KEY=minioadmin
VIP_MINIO__SECRET_KEY=minioadmin
VIP_MINIO__SECURE=false
VIP_MINIO__PUBLIC_SECURE=false
VIP_MINIO__PRESIGNED_URL_TTL_SECONDS=300
# Safe identity bootstrap is enabled by default. Visual embeddings remain off
# until a verified, versioned TorchScript checkpoint is explicitly configured.
VIP_IDENTITY__ENABLED=true
VIP_IDENTITY__MAXIMUM_PLATE_ALIASES=16
VIP_IDENTITY__VECTOR_CANDIDATE_LIMIT=1000
VIP_IDENTITY__TOPOLOGY_EDGE_LIMIT=64
VIP_IDENTITY__CANDIDATES_PER_EDGE=100
VIP_IDENTITY__CROSS_CAMERA_CANDIDATE_LIMIT=200
VIP_IDENTITY__JOURNEY_EVENT_LIMIT=1000
VIP_IDENTITY__EMBEDDING__ENABLED=false
# VIP_IDENTITY__EMBEDDING__MODEL_PATH=models/vehicle-reid-v1.torchscript
# VIP_IDENTITY__EMBEDDING__MODEL_NAME=vehicle-reid
# VIP_IDENTITY__EMBEDDING__MODEL_VERSION=v1
# VIP_IDENTITY__EMBEDDING__MODEL_HASH=<sha256-hex>
# VIP_IDENTITY__EMBEDDING__DIMENSION=256
VIP_IDENTITY__REID__ENABLED=true
VIP_IDENTITY__REID__SCORING_VERSION=reid-score-v1
VIP_IDENTITY__REID__MATCH_THRESHOLD=0.88
VIP_IDENTITY__REID__REVIEW_THRESHOLD=0.65
VIP_IDENTITY__REID__MAXIMUM_SCORED_CANDIDATES=100
# Quality queries are UTC, server-aggregated in MongoDB, and bounded by window.
VIP_MODEL_QUALITY__DEFAULT_WINDOW_DAYS=30
VIP_MODEL_QUALITY__MAXIMUM_WINDOW_DAYS=365
VIP_MODEL_QUALITY__MAXIMUM_MODELS=50
# Reviewed OCR crops are exported outside object storage as immutable, checksummed
# training handoffs. Splits are assigned by camera, never by individual frame.
VIP_DATASET_EXPORT__OUTPUT_DIRECTORY=datasets/exports
VIP_DATASET_EXPORT__BATCH_SIZE=500
VIP_DATASET_EXPORT__MAXIMUM_IMAGE_BYTES=5000000
VIP_DATASET_EXPORT__MAXIMUM_IMAGE_PIXELS=20000000
VIP_DATASET_EXPORT__CLAIM_STALE_SECONDS=600
VIP_DATASET_EXPORT__TRAIN_RATIO=0.8
VIP_DATASET_EXPORT__VALIDATION_RATIO=0.1
VIP_DATASET_EXPORT__TEST_RATIO=0.1
VIP_DATASET_EXPORT__SPLIT_SEED=camera-split-v1
