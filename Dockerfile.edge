FROM python:3.12.14-slim-trixie@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN python -m pip install --no-cache-dir uv==0.8.8

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --locked --no-dev --no-editable \
      --extra edge --extra minio --extra optimization --extra vision

FROM python:3.12.14-slim-trixie@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIP_EDGE_MANIFEST=/run/edge/manifest.json \
    VIP_EDGE_MODEL_ROOT=/models \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

RUN groupadd --system vehicle && useradd --system --gid vehicle --home /app vehicle && \
    apt-get update && \
    apt-get install --no-install-recommends --yes libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY configs ./configs

RUN mkdir -p /models /data /run/edge && \
    chown -R vehicle:vehicle /app /data /run/edge

USER vehicle

VOLUME ["/models", "/data"]

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import os; os.kill(1, 0); assert os.path.isfile(os.environ['VIP_EDGE_MANIFEST'])"]

ENTRYPOINT ["vehicle-edge-entrypoint"]
