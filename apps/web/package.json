{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "check:styles": "node scripts/check_css_contract.mjs",
    "lint": "eslint . --max-warnings=0",
    "prebuild": "npm run check:styles",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:contracts": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.3",
    "@lucide/angular": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "angular-eslint": "22.1.0",
    "eslint": "10.9.1",
    "less": "4.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "^4.1.10"
  }
}
